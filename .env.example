# Public browser configuration. These values are not secrets.
# Must point to the public HTTPS Bionic PEA Adapter / trusted gateway.
VITE_API_BASE_URL=

# Exact Keycloak realm issuer URL (the issuer value from OIDC discovery).
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=pea-web

# Optional; defaults to current origin + Vite BASE_URL.
VITE_OIDC_REDIRECT_URI=https://dach1980.github.io/Personal_Expert_AI_Web/

# Keep false for the real application. Demo mode does not call the model.
VITE_DEMO_MODE=false
