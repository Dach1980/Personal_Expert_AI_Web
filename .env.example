# Public Bionic API origin. Browser requests go through the Bionic PEA Adapter.
VITE_API_BASE_URL=https://bionic-api.example.invalid

# Shared Keycloak realm. Configure this to the exact issuer discovered from the realm.
VITE_OIDC_ISSUER=https://sso.example.invalid/realms/bionic-gpt
VITE_OIDC_CLIENT_ID=pea-web
# Optional; defaults to current origin + Vite BASE_URL.
VITE_OIDC_REDIRECT_URI=https://dach1980.github.io/Personal_Expert_AI_Web/
